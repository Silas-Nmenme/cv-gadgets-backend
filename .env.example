# CV GADGETS backend configuration
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Keep the deployed frontend origin in this list for production CORS.
FRONTEND_ORIGINS=https://cv-gadgets.vercel.app,http://localhost:5500,http://127.0.0.1:5500
STOREFRONT_URL=http://localhost:5500
# In production, set STOREFRONT_URL=https://cv-gadgets.vercel.app

# One-time administrator bootstrap. Remove after the first admin account is created.
ADMIN_REGISTRATION_KEY=replace-with-a-random-one-time-key-at-least-32-characters

# Payments (Paystack is implemented; use test credentials first)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5500/thank-you.html
# In production, set PAYSTACK_CALLBACK_URL=https://cv-gadgets.vercel.app/thank-you.html
BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
PAY_ON_DELIVERY_ENABLED=false

# Store contact and delivery. Use international format without + for WhatsApp, e.g. 234XXXXXXXXXX.
SHOP_WHATSAPP_NUMBER=
# Set this to the administrator inbox for order, payment, contact and review notifications.
SHOP_OWNER_EMAIL=
DELIVERY_FEE_LAGOS=0
DELIVERY_FEE_NATIONWIDE=0

# Cloudinary product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PASSWORD_RESET_ENABLED=true
